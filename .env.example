# Kopieer naar .env en vul in. Lege waarden = bron uitgeschakeld.
TZ=Europe/Amsterdam
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# Geheim voor POST /api/alarms vanaf je telefoon (header X-Dashboard-Secret)
DASHBOARD_SECRET=verander-dit

# --- Fase 0: iCal-feeds (geen OAuth nodig) ---
# TimeEdit: cloud.timeedit.net/nl_utwente/web/ -> je rooster -> Abonneren / Subscribe -> kopieer de .ics-link
TIMEEDIT_ICS_URL=
TIMEEDIT_WEB_URL=https://cloud.timeedit.net/nl_utwente/web/
# Google Calendar: Instellingen -> je agenda -> "Privéadres in iCal-formaat"
GCAL_ICS_URL=
# Canvas: canvas.utwente.nl -> Agenda -> "Calendar Feed" (rechtsonder)
CANVAS_ICS_URL=
# Outlook (UT): outlook.office.com -> Instellingen -> Agenda -> Gedeelde agenda's -> Agenda publiceren -> ICS-link
OUTLOOK_ICS_URL=

# --- Fase 1: Trello + Canvas API ---
# Trello: https://trello.com/power-ups/admin -> Power-Up aanmaken -> API key + Token genereren
TRELLO_KEY=
TRELLO_TOKEN=
# Het deel na trello.com/b/ in de URL van het Duitenberg-bord
TRELLO_BOARD_ID=
# Canvas: Account -> Instellingen -> "+ Nieuw toegangstoken"
CANVAS_BASE_URL=https://canvas.utwente.nl
CANVAS_TOKEN=

# --- Fase 2: Google OAuth (Gmail + Calendar API). Zie scripts/google_auth.py ---
GOOGLE_CREDENTIALS_FILE=data/google_credentials.json
GOOGLE_TOKEN_FILE=data/google_token.json

# --- Fase 3: Microsoft Graph (UT-account). Zie scripts/ms_auth.py ---
MS_CLIENT_ID=
MS_TOKEN_FILE=data/ms_token.json
